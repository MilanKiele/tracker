# Browser and server-side Supabase Auth. Use the project URL and anon/publishable key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key
SITE_URL=http://localhost:3000

# Push notifications. Keep the private key server-only.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:you@example.com

# Vercel scheduled reminder route. Use a random secret.
CRON_SECRET=replace-with-a-random-secret

# Server-only Supabase admin key, required only for scheduled push delivery.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
