# Existing Supabase project. Use the same values locally and on Vercel.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key
SITE_URL=http://localhost:3000

# Server only. Free text + image understanding; no paid fallback.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
# Optional: comma-separated account emails. Empty permits all signed-in users.
AI_ALLOWED_EMAILS=

# Push notifications. The public key is browser-safe.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
CRON_SECRET=
# Server only; required for scheduled push delivery.
SUPABASE_SERVICE_ROLE_KEY=
